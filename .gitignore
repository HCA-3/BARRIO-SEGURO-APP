# Salidas del build Android
app/build/
.gradle/
build/
local.properties
*.apk
*.aab
!apk/*.apk

# Archivos de entorno virtual y caches de Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.sqlite3
*.db

# Caches de HuggingFace / Transformers / Torch
.cache/
hf_cache/

# Salidas de generacion o modelos entrenados
Agente/fine_tuning_qwen/lora_salida/
Agente/output/
!Agente/output/.gitkeep
!Agente/output/rag_index/

# Logs y temporales
*.log
.DS_Store
Thumbs.db

# Configuración del IDE que no debe rastrearse
.idea/workspace.xml
.idea/caches/
.idea/shelf/
.idea/assetWizardSettings.xml
.idea/compiler.xml
.idea/encodings.xml
.idea/kotlinc.xml
.idea/runConfigurations.xml
.idea/modules.xml

# Salidas del script del agente (para que no ensucie git status)
Agente/output/*.csv
Agente/output/*.png
Agente/output/*.xlsx
Agente/output/*.url
/.idea/claudeCodeEditorTabs.xml

# Claves locales del servidor
.env
